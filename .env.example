APP_NAME="Carteira financeira"
APP_ENV=local
# Fixed demo key, committed on purpose: this local/demo Docker stack has no
# TLS and its dashboards are unauthenticated (spec's own "prod-shaped but
# runs local"), and every service (app/worker/pulse/scheduler) shares this
# same .env via `env_file:` — .env is never copied into the image nor
# volume-mounted, so `php artisan key:generate` has no file to write to
# inside a container, and per-container random keys would silently break
# session/cookie decryption across them. Never reuse this key for a real
# deploy — generate a real one and keep it out of version control there.
APP_KEY=base64:R9SBfxJJaeLST6bVF0AIcYhYB+bvSEStRpCl18IVxrg=
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OCTANE_SERVER=frankenphp

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wallet
DB_USERNAME=wallet
DB_PASSWORD=wallet

SESSION_DRIVER=database
SESSION_LIFETIME=45
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=localhost
CORS_ALLOWED_ORIGINS=http://localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@wallet.test"
MAIL_FROM_NAME="${APP_NAME}"

PULSE_INGEST_DRIVER=redis

# Never true in production (Task 17): registered only when
# app()->environment('local'). Turning this off here also avoids
# TelescopeServiceProvider eagerly touching the Redis `default`/cache
# connection on a host that isn't running inside this Docker network (a plain
# host-side `php artisan` invocation reads this same file). Overridden to
# `true` on the `app` service in compose.yml, where Telescope is meant to run.
TELESCOPE_ENABLED=false

HORIZON_DASHBOARD_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
